<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Toggle Samsung's system auto-rotate. Granted in-app via "설정 수정 허용"; no PC/adb. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Needed to list installed apps so the user can register one, and to launch it.
         Only package names / launcher metadata are read. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Ask the user to exempt us from battery optimization so One UI does not sleep the
         exit-detection service. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- NOTE: no INTERNET and no SYSTEM_ALERT_WINDOW — this is a fully offline utility that
         never draws over other apps. -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PerAppRotation"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PerAppRotation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible trampoline started by the widget / shortcut / quick-launch icon. -->
        <activity
            android:name=".StartSessionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
            Second launcher entry that runs a session in one tap and shows no UI. Being a real
            launcher icon (not a widget) it can be dropped into a folder or picked up by
            shortcut-collection apps, while still sharing this app's permissions and the
            exit-detection service.
        -->
        <activity-alias
            android:name=".QuickLaunch"
            android:targetActivity=".StartSessionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@mipmap/ic_launcher_quick"
            android:roundIcon="@mipmap/ic_launcher_quick_round"
            android:label="@string/quick_launch_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".widget.StartWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/start_widget_info" />
        </receiver>

        <service
            android:name=".service.ExitWatchService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
