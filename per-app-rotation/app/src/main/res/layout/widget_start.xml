<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_background"
        android:padding="6dp">

        <!-- The registered app's own icon, so the tile is recognisable at a glance. -->
        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_widget_rotate"
            android:contentDescription="@string/widget_description" />

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />
    </LinearLayout>

    <!-- Small rotation badge; tinted green while a session is running. -->
    <ImageView
        android:id="@+id/widget_badge"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_widget_rotate"
        android:contentDescription="@string/widget_description" />
</FrameLayout>
