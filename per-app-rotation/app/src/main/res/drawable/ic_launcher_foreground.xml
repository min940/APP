<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
        "Auto-rotate launcher": a circular rotation arrow (two stroked arcs + arrowheads) wrapping a
        play/launch triangle. Geometry is centred on (54,54) and stays inside the 72dp adaptive-icon
        safe zone.
    -->
    <group android:translateX="54" android:translateY="54">

        <!-- Rotation arcs -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="butt"
            android:pathData="M 22.12,-15.49 A 27,27 0 0 1 -11.41,24.47" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="butt"
            android:pathData="M -22.12,15.49 A 27,27 0 0 1 11.41,-24.47" />

        <!-- Arrowheads, tangent to each arc end -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M -22.29,19.40 L -14.45,31.00 L -8.37,17.94 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 22.29,-19.40 L 14.45,-31.00 L 8.37,-17.94 Z" />

        <!-- Launch mark -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M -6,-9.5 L 10.5,0 L -6,9.5 Z" />
    </group>
</vector>
